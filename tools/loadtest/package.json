{
  "name": "@ins/loadtest",
  "version": "0.0.0",
  "private": true,
  "description": "Load tests: a Socket.IO client fleet, a server sampler and a replay driver.",
  "type": "module",
  "scripts": {
    "loadtest": "node --disable-warning=ExperimentalWarning src/cli.ts",
