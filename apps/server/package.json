{
  "name": "@ins/server",
  "version": "0.0.0",
  "private": true,
  "description": "Express API, Socket.IO delivery and the ingest pipeline.",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env --disable-warning=ExperimentalWarning src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ins/shared": "workspace:*",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.8.0",
    "pino": "^10.4.0",
    "socket.io": "^4.8.4",
    "socket.io-msgpack-parser": "^3.0.2",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
