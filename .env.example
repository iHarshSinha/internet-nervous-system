# Copy this file to .env and fill it in. Never commit .env.
# Both `pnpm dev` and `docker compose` read .env from the repository root.

# --- Used now -----------------------------------------------------------------

# live = read the real feeds; replay = play recorded events through the same pipeline.
# (Docker Compose sets this itself from the profile you choose: live or demo.)
MODE=live

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Leave unset for local work: `pnpm dev` uses mongodb://127.0.0.1:27017/ins and
# Docker Compose uses its own mongo container. Set it only to use MongoDB Atlas.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ins

# Address the proxy serves. ":8080" is plain HTTP for local runs; a real domain
# (example.com) makes Caddy fetch an HTTPS certificate automatically.
SITE_ADDRESS=:8080

# Live sources. Set INGEST=off to run without connecting to the feeds.
INGEST=on
# Feeds, pipeline and detectors run in their own worker thread; "off" keeps them in the main thread.
INGEST_THREAD=on
# Events the ingest queue holds before shedding route announcements (sampling starts at 70%).
INGEST_QUEUE_MAX=100000

# Delivery optimisations; each can be switched off to measure what it saves.
SOCKET_PARSER=msgpack   # or json
CONFLATE_MS=500         # 0 sends every change as its own frame
BROADCAST=rooms         # or all (every frame to every client)
SLOW_CLIENTS=on

# Optional: a scraper sending this bearer token may read /metrics (admins always can). 24+ chars.
METRICS_TOKEN=
# RIS Live asks every client to identify itself.
RIS_CLIENT_NAME=internet-nervous-system
# One upstream connection per collector. rrc00 alone is about 600 messages per second.
RIS_COLLECTORS=rrc00,rrc10,rrc11,rrc14
# RIPE Atlas built-in ping measurements (root DNS servers).
ATLAS_MEASUREMENTS=1001,1008,1006
# Download network and probe locations (cached in MongoDB; networks weekly, probes daily).
REFDATA=on
# Per minute, store history for at most this many of the busiest networks.
METRICS_ASN_LIMIT=300

# --- Sign-in (Google) and access control ------------------------------------

# OAuth client ID from Google Cloud ("Web application"). Without it, sign-in is
# hidden and the app is visitor-only. The client SECRET is not used: never add it.
GOOGLE_CLIENT_ID=

# Google accounts that get the admin role, comma-separated.
ADMIN_EMAILS=

# Signs session tokens. Required in production. Generate with: openssl rand -hex 32
JWT_SECRET=

# --- Rate limits (defaults; see docs/architecture.md) ----------------------------------
# API_RATE_PER_MIN=100
# AUTH_RATE_PER_MIN=10
# SOCKET_CONNECTIONS_PER_MIN=20
# SOCKET_MESSAGES_PER_SEC=5

# --- Used from later phases ------------------------------------------------------

# --- Cloudflare Radar (optional) ------------------------------------------------
# A free API token with the permission Account > Radar > Read. Without it the Radar
# layer (attack arcs, outage reports, confirmation of incidents) stays off.
CLOUDFLARE_API_TOKEN=
# How often to poll events and attack pairs, in seconds.
# RADAR_EVENTS_EVERY_S=180
# RADAR_PAIRS_EVERY_S=900
